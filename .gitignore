# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# prisma (SQLite 로컬 DB 파일 — 구버전 단일 앱 시절 유물)
/prisma/*.db
/prisma/*.db-journal

# typescript
*.tsbuildinfo
next-env.d.ts

# monorepo: 각 패키지/앱 빌드 산출물
packages/*/dist
apps/api/dist

# apps/api: 업로드된 미디어 파일 (파일 자체는 배포 서버 로컬 디스크에만 존재)
apps/api/uploads/*
!apps/api/uploads/.gitkeep

# deploy/local-demo.sh 실행 중 생성되는 로그/PID 파일
deploy/.logs/
deploy/.demo-pids
