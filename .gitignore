# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (テンプレートである.env.exampleはコミット対象なので除外)
.env*
!.env.example
!apps/*/.env.example

# vercel
.vercel

# prisma (SQLiteのローカルDBファイル — 旧バージョン単一アプリ時代の遺物)
/prisma/*.db
/prisma/*.db-journal

# typescript
*.tsbuildinfo
next-env.d.ts

# モノレポ: 各パッケージ/アプリのビルド成果物
packages/*/dist
apps/api/dist

# apps/api: アップロードされたメディアファイル(ファイル自体はデプロイサーバーのローカルディスクにのみ存在)
apps/api/uploads/*
!apps/api/uploads/.gitkeep

# deploy/local-demo.sh 実行中に生成されるログ/PIDファイル
deploy/.logs/
deploy/.demo-pids
