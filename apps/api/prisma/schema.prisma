// Prismaスキーマ: ヘッドレスCMSの中核となるコンテンツモデルを定義します。
// structure.mdの「1 CMS = 1 Site」原則に従い、V1ではSiteを1つだけ作成しますが、
// 将来のマルチサイト拡張に備えてコンテンツモデルにsiteId FKをあらかじめ付けています。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT // 下書き(未公開)
  PUBLISHED // 公開済み(公開API/サイトに露出)
}

// 将来のマルチサイト拡張のための場所。V1ではこのテーブルに行が1つだけ存在します。
model Site {
  id         String      @id @default(cuid())
  name       String
  domain     String      @unique
  createdAt  DateTime    @default(now())
  posts      Post[]
  categories Category[]
  pages      Page[]
  media      Media[]
  blockTypes BlockType[]
}

// 管理者ログインアカウント。V1では1サイトに管理者1名のみを想定します(権限/ロールの区別なし)。
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  createdAt    DateTime @default(now())
}

model Post {
  id          String        @id @default(cuid())
  site        Site          @relation(fields: [siteId], references: [id])
  siteId      String
  title       String
  slug        String        @unique
  excerpt     String? // 一覧に表示する要約。なければ本文から自動生成
  content     Json // 本文 — ブロックエディタのBlock[](packages/blocks参照)
  status      ContentStatus @default(DRAFT)
  author      String        @default("Admin")
  thumbnail   Media?        @relation(fields: [thumbnailId], references: [id])
  thumbnailId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  categories  Category[]

  @@index([siteId, status, createdAt])
}

// WordPressのカテゴリーのように、1つの記事が複数のカテゴリーに属することができます(多対多)。
model Category {
  id        String   @id @default(cuid())
  site      Site     @relation(fields: [siteId], references: [id])
  siteId    String
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  posts     Post[]

  @@index([siteId])
}

// 静的ページ(会社概要、利用規約など)。Postと違ってカテゴリー/作成者の概念がない
// シンプルなコンテンツモデルです。Custom Post Typeのような汎用エンジンはV1の範囲外です。
model Page {
  id        String        @id @default(cuid())
  site      Site          @relation(fields: [siteId], references: [id])
  siteId    String
  title     String
  slug      String        @unique
  content   Json
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([siteId, status])
}

// アップロードされた画像/ファイルのメタデータ。実際のファイルはAPIサーバーのローカルディスク
// (apps/api/uploads)に保存され、urlはそのファイルを指す絶対/相対パスです。
model Media {
  id        String   @id @default(cuid())
  site      Site     @relation(fields: [siteId], references: [id])
  siteId    String
  filename  String
  url       String
  mimeType  String
  size      Int
  alt       String?
  createdAt DateTime @default(now())
  posts     Post[]

  @@index([siteId])
}

// ACFのフィールドグループに相当するカスタムブロックの定義。管理画面でfields(FieldDef[]、
// packages/blocks参照)だけを構成でき、実際の見た目(HTML/デザイン)はfieldsの値を
// BlockRenderer/blocksToHtmlのカスタムレンダラーとして開発者が別途登録して描画する。
// 未登録のブロックタイプでもラベル:値のリストとして安全にフォールバック表示される。
model BlockType {
  id        String   @id @default(cuid())
  site      Site     @relation(fields: [siteId], references: [id])
  siteId    String
  name      String
  slug      String   @unique
  fields    Json // FieldDef[](packages/blocks参照)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}
