# ---------------------------------------------------------------------------
# /etc/caddy/Caddyfile に入れる内容です。
#
# example.comの3箇所を実際のドメインに置き換えて:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# HTTPS証明書はCaddyがLet's Encryptから自動発行/更新します。
# ただし、ドメインのAレコードがこのサーバーのIPを指している必要があります。
# 発行に失敗した場合: sudo journalctl -u caddy -n 50
# ---------------------------------------------------------------------------

# 公開Webサイト
example.com, www.example.com {
	encode gzip zstd
	reverse_proxy localhost:3000
}

# 管理画面
admin.example.com {
	encode gzip zstd
	reverse_proxy localhost:3001
}

# API — アップロードされた画像(/uploads)もこのホストで配信されます
api.example.com {
	encode gzip zstd

	# メディアアップロードの容量制限(デフォルト値が低いと大きい画像が413で弾かれます)
	request_body {
		max_size 50MB
	}

	reverse_proxy localhost:4000
}
