# ===========================================================================
# サーバー用環境変数テンプレート。example.comを実際のドメインに置き換えて
# 下の3つのファイルに分けて保存してください。
# ===========================================================================


# --- apps/api/.env ---------------------------------------------------------
# DATABASE_URL はserver-setup.shが出力してくれた値をそのまま貼り付けてください。
DATABASE_URL="postgresql://cms:ここに生成されたパスワード@localhost:5432/cms"
PORT=4000
# 必ず新しく生成してください: openssl rand -hex 32
JWT_SECRET="ここにopenssl_rand_hex_32の結果"
JWT_EXPIRES_IN="7d"
ADMIN_EMAIL="admin@example.com"
# デモ中に画面に表示される可能性があるので、覚えやすいが推測できない値にしてください
ADMIN_PASSWORD="ここにデモ用パスワード"
# ここにないオリジンからのリクエストはブラウザにブロックされます。タイプミス注意。
CORS_ORIGINS="https://example.com,https://www.example.com,https://admin.example.com"


# --- apps/admin/.env.production --------------------------------------------
# API_URL: サーバー内部(SSR)から呼び出し — localhostにしておくとネットワークを経由しないので速いです
# NEXT_PUBLIC_API_URL: ブラウザから呼び出し — 必ず公開httpsアドレスである必要があります
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=https://api.example.com


# --- apps/website/.env.production ------------------------------------------
NEXT_PUBLIC_API_URL=https://api.example.com
