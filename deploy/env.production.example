# ===========================================================================
# 서버용 환경변수 템플릿. example.com 을 실제 도메인으로 바꿔서
# 아래 3개 파일로 나눠 저장하세요.
# ===========================================================================


# --- apps/api/.env ---------------------------------------------------------
# DATABASE_URL 은 server-setup.sh 가 출력해준 값을 그대로 붙여넣으세요.
DATABASE_URL="postgresql://cms:여기에_생성된_비밀번호@localhost:5432/cms"
PORT=4000
# 반드시 새로 생성하세요:  openssl rand -hex 32
JWT_SECRET="여기에_openssl_rand_hex_32_결과"
JWT_EXPIRES_IN="7d"
ADMIN_EMAIL="admin@example.com"
# 시연 중 화면에 노출될 수 있으니 외우기 쉽되 추측 불가능한 값으로
ADMIN_PASSWORD="여기에_시연용_비밀번호"
# 여기에 없는 출처에서 온 요청은 브라우저가 차단합니다. 오타 주의.
CORS_ORIGINS="https://example.com,https://www.example.com,https://admin.example.com"


# --- apps/admin/.env.production --------------------------------------------
# API_URL: 서버 내부(SSR)에서 호출 — localhost로 두면 네트워크를 안 타서 빠릅니다
# NEXT_PUBLIC_API_URL: 브라우저에서 호출 — 반드시 공개 https 주소여야 합니다
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=https://api.example.com


# --- apps/website/.env.production ------------------------------------------
NEXT_PUBLIC_API_URL=https://api.example.com
